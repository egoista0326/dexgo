---
// A one-sentence heading as in the project video: phrases between *...* are drawn in the accent colour. An optional
// `subheading` (same *...* marking) is set as one muted line directly under it, e.g. a method component's name as
// the heading and its key phrase below (owner 2026-11-23).
interface Props {
  text: string;
  subheading?: string;
  level?: 2 | 3;
  id?: string;
  class?: string;
}

const { text, subheading, level = 3, id, class: className } = Astro.props;
const Tag = level === 2 ? 'h2' : 'h3';
// Each part: whether it is a key phrase, and its pieces; odd pieces are hyphenated words ("Long-horizon"),
// kept on one line.
const split = (line: string) =>
  line.split('*').map((part, index) => ({ key: index % 2 === 1, pieces: part.split(/([A-Za-z]+(?:-[A-Za-z]+)+)/) }));
const parts = split(text);
const subParts = subheading ? split(subheading) : [];
---

<Tag id={id} class:list={['dx-heading', subheading && 'dx-heading-has-sub', className]}>
  {
    parts.map(({ key, pieces }) => {
      const content = pieces.map((piece, i) => (i % 2 === 1 ? <span class="dx-nobr">{piece}</span> : piece));
      return key ? <span class="dx-key">{content}</span> : content;
    })
  }
</Tag>
{
  subheading ? (
    <p class="dx-subheading">
      {subParts.map(({ key, pieces }) => {
        const content = pieces.map((piece, i) => (i % 2 === 1 ? <span class="dx-nobr">{piece}</span> : piece));
        return key ? <span class="dx-key">{content}</span> : content;
      })}
    </p>
  ) : null
}
