---
// The paper's overview figure as a vector graphic (its web cut, with labels set for the 800 px column). Three
// regions link to the subsections that explain them (which follow the figure directly, in the same order). The
// affordance (owner 2026-11-24, replacing the row of section links): a hint line above the figure and, at rest, a
// faint teal tint and ring on each region with a small down-arrow badge on its top-right corner; hovering a region
// strengthens both. The
// regions are pointer targets only: the keyboard reaches the subsections by reading on. Below 864 px (the figure
// under 800 px, labels under the readable size) an "Open the figure" link under the figure opens the figure page
// (/dexgo/figure/), where it is 1000 px wide in a horizontally scrolling box. Below 720 px the figure is a thumbnail:
// the regions, their badges and the hint are hidden, and the whole image opens the figure page too.
interface Hotspot {
  target: string;
  label: string;
  /** [x, y, w, h] in the SVG's viewBox units. */
  rect: [number, number, number, number];
}

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  hotspots: Hotspot[];
  /** Accessible name of the figure. */
  label: string;
  /** The line above the figure that says the regions are links (from 720 px). */
  hint: string;
  /** Text of the link to the full-size figure (shown below 864 px), and that page's path. */
  openLabel: string;
  openHref: string;
}

const { src, width, height, alt, hotspots, label, hint, openLabel, openHref } = Astro.props;
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
---

<figure class="dx-method-figure" aria-label={label} data-method-figure>
  <p class="dx-method-hint" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 7v9M8 12.5l4 4 4-4" /></svg>
    {hint}
  </p>
  <div class="dx-method-stage" style={`aspect-ratio: ${width} / ${height}`}>
    <img src={src} alt={alt} width="800" height={Math.round((800 * height) / width)} decoding="async" loading="lazy" />
    <a class="dx-method-zoom" href={openHref} tabindex="-1" aria-hidden="true"></a>
    {
      hotspots.map((spot) => (
        <a
          class="dx-hotspot"
          href={`#${spot.target}`}
          aria-label={spot.label}
          tabindex="-1"
          aria-hidden="true"
          data-spot={spot.target}
          style={`left: ${pct(spot.rect[0], width)}; top: ${pct(spot.rect[1], height)}; width: ${pct(spot.rect[2], width)}; height: ${pct(spot.rect[3], height)}`}
        >
          <span class="dx-hotspot-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" focusable="false"><path d="M12 5v13M6 12.5l6 6 6-6" /></svg>
          </span>
        </a>
      ))
    }
  </div>
  <div class="dx-spot-links">
    <a class="dx-method-open" href={openHref}>{openLabel}</a>
  </div>
</figure>

<script>
  // Hovering a region marks it (tint and ring, global.css).
  for (const spot of document.querySelectorAll<HTMLElement>('[data-method-figure] [data-spot]')) {
    spot.addEventListener('pointerenter', () => spot.classList.add('is-lit'));
    spot.addEventListener('pointerleave', () => spot.classList.remove('is-lit'));
  }
</script>
